<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Recording; asked for the first time the app needs the microphone. Phones without one still install it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- In-app updates and the sound library's download (#66): the network, whether it is metered (Wi-Fi only by
         default), and the system's installer for an update's APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/honeydew"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity
            android:name="dev.daijro.honeydew.HoneydewActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="honeydew" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The user folder in the system Files app and every app's document picker (HoneydewDocuments). -->
        <provider
            android:name="dev.daijro.honeydew.HoneydewDocuments"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- An update's APK for the system's installer (HoneydewUpdate): read grants only, never exported. -->
        <provider
            android:name="dev.daijro.honeydew.HoneydewUpdate"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>

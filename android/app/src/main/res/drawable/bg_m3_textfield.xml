<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_lowest" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/m3_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_container_lowest" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_outline" />
        </shape>
    </item>
</selector>

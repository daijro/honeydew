# Honeydew behind Caddy 2 (README "Web"). The site folder is dist/ after tools/web-dist.sh, or the release zip's
# folder. Change the path and the address to yours.
:8080 {
	root * /srv/honeydew

	# Precompressed: a request for x is answered from x.gz with Content-Encoding: gzip when the client accepts gzip,
	# and from x otherwise. The wasm and the packs are fetched as their .gz, which goes out as it is and is gunzipped
	# in the browser. Text without a .gz beside it (content/index.json) is compressed on the fly.
	file_server {
		precompressed gzip
	}
	encode gzip

	# Trunk's wasm and JS and the packs are named by their content: kept for good. The rest revalidates.
	@hashed path *.wasm *.wasm.gz *.js *.js.gz /content/p/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@named not path *.wasm *.wasm.gz *.js *.js.gz /content/p/*
	header @named Cache-Control "no-cache"

	# Not in every system's type table.
	@tar path *.tar
	header @tar Content-Type application/x-tar
}
